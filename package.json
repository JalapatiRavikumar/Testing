{
  "name": "restful-booker-qa",
  "version": "1.0.0",
  "description": "API and UI testing for Restful Booker",
  "scripts": {
    "test:api": "newman run postman/restful-booker.collection.json -e postman/restful-booker.environment.json -r \"cli,htmlextra\" --reporter-htmlextra-export postman/reports/api-report.html",
    "test:ui": "npm --prefix playwright run test",
    "test:ui:headed": "npm --prefix playwright run test:headed",
    "test:ui:report": "npm --prefix playwright run test:report",
    "test": "npm run test:api && npm run test:ui"
  }
}
